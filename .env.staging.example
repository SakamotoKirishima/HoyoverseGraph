# Backend staging environment template.
# Copy into your staging host's secret/environment configuration.

DATABASE_URL=postgresql://<user>:<password>@<host>/<database>?sslmode=require
# Optional: use a direct Neon connection string for schema/bootstrap or admin tasks.
DATABASE_URL_DIRECT=postgresql://<user>:<password>@<host>/<database>?sslmode=require
ALLOWED_ORIGINS=https://<staging-frontend-domain>
PORT=8000
